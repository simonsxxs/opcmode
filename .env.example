# opcmode 小红书图文生成器 MVP
# 复制为 .env.local 后填写。不要提交 .env.local。

# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.2
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_GENERATE_IMAGES=true

# Supabase server-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=redbook-images

# Supabase browser auth
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Card-code hashing pepper. Use a long random string.
CARD_CODE_PEPPER=
